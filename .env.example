# Copy to .env for running scripts/webhooks.py locally. Never commit .env.
# Values are printed by infra/deploy.sh at the end of the deployment.

# Required
KEYVAULT_URL=https://kv-glbranch-xxxxxxxx.vault.azure.net/
WEBHOOK_URL=https://func-glbranch-xxxxxxxx.azurewebsites.net/api/gitlab-webhook

# Optional: use a specific identity instead of your `az login` account
# AZURE_CLIENT_ID=

# Optional: override any key from function_app/config/automation.json
# SOURCE_GROUPS=my-group
# EXCLUDE_REPOS=my-group/sandbox/*
# RELEASE_BRANCH=release
