#!/bin/sh
set -e

# Check AZURE_CLIENT_ID env var
if [ -z "$AZURE_CLIENT_ID" ]; then
  echo "[ERROR] AZURE_CLIENT_ID is not set. Please set it before starting Alloy."
  exit 1
fi

echo "[INFO] Testing Azure Managed Identity login..."
if ! az login --identity --username "$AZURE_CLIENT_ID" >/dev/null 2>&1; then
  echo "[ERROR] Could not log in with UAMI (client_id=$AZURE_CLIENT_ID)."
  echo "        Make sure the identity is assigned to this pod and has SQL DB access."
  exit 1
fi

echo "[INFO] Managed Identity login successful."

echo "[INFO] Testing Azure SQL DB connectivity..."

# Attempt a simple connection test with sqlcmd (make sure sqlcmd is in the container)
if ! sqlcmd -S tcp:$SQL_SERVER_NAME.database.windows.net -d $SQL_DB_NAME -G -U "$AZURE_CLIENT_ID" -Q "SELECT 1" >/dev/null 2>&1; then
  echo "[ERROR] Unable to connect to Azure SQL DB. Check permissions for UAMI on the database."
  exit 1
fi

echo "[INFO] Azure SQL DB connectivity verified."

# Start Alloy
exec /bin/alloy "$@"


apiVersion: v1
kind: ConfigMap
metadata:
  name: alloy-entrypoint
data:
  alloy-entrypoint.sh: |
    #!/bin/sh
    set -e

    if [ -z "$AZURE_CLIENT_ID" ]; then
      echo "[ERROR] AZURE_CLIENT_ID is not set. Please set it before starting Alloy."
      exit 1
    fi

    echo "[INFO] Testing Azure Managed Identity login..."
    if ! az login --identity --username "$AZURE_CLIENT_ID" >/dev/null 2>&1; then
      echo "[ERROR] Could not log in with UAMI (client_id=$AZURE_CLIENT_ID)."
      echo "        Make sure the identity is assigned to this pod and has SQL DB access."
      exit 1
    fi

    echo "[INFO] Managed Identity login successful."

    echo "[INFO] Testing Azure SQL DB connectivity..."

    if ! sqlcmd -S tcp:$SQL_SERVER_NAME.database.windows.net -d $SQL_DB_NAME -G -U "$AZURE_CLIENT_ID" -Q "SELECT 1" >/dev/null 2>&1; then
      echo "[ERROR] Unable to connect to Azure SQL DB. Check permissions for UAMI on the database."
      exit 1
    fi

    echo "[INFO] Azure SQL DB connectivity verified."

    exec /bin/alloy "$@"


containers:
  - name: alloy
    image: grafana/alloy:latest
    env:
      - name: AZURE_CLIENT_ID
        value: "12345678-abcd-1234-abcd-1234567890ab"
      - name: SQL_SERVER_NAME
        value: "<your-sql-server-name>"
      - name: SQL_DB_NAME
        value: "<your-database-name>"
    volumeMounts:
      - name: entrypoint-script
        mountPath: /entrypoint.sh
        subPath: alloy-entrypoint.sh
        readOnly: true
    command: ["/bin/sh", "/entrypoint.sh"]
volumes:
  - name: entrypoint-script
    configMap:
      name: alloy-entrypoint
      defaultMode: 0755


apiVersion: apps/v1
kind: Deployment
metadata:
  name: pushgateway
  namespace: monitoring
labels:
  app: pushgateway
spec:
  replicas: 1
  selector:
    matchLabels:
      app: pushgateway
  template:
    metadata:
      labels:
        app: pushgateway
    spec:
      containers:
      - name: pushgateway
        image: prom/pushgateway:latest
        ports:
        - containerPort: 9091
        resources:
          limits:
            cpu: "100m"
            memory: "128Mi"
          requests:
            cpu: "50m"
            memory: "64Mi"




apiVersion: v1
kind: Service
metadata:
  name: pushgateway
  namespace: monitoring
spec:
  selector:
    app: pushgateway
  ports:
  - protocol: TCP
    port: 9091
    targetPort: 9091
  type: ClusterIP





apiVersion: v1
kind: Pod
metadata:
  name: debug-uami-pod
  namespace: default
spec:
  serviceAccountName: debug-uami-sa
  nodeSelector:
    kubernetes.io/os: linux
  containers:
  - name: debug-container
    image: mcr.microsoft.com/azure-cli:2.64.0
    env:
      - name: AZURE_CLIENT_ID
        value: "<UAMI-CLIENT-ID>"
      - name: AZURE_TENANT_ID
        value: "<TENANT-ID>"
    command:
      - /bin/sh
      - -c
      - |
        cat <<'EOF' > /tmp/debug-identity.sh
        #!/bin/sh

        echo "=== Environment Variables ==="
        echo "AZURE_CLIENT_ID: $AZURE_CLIENT_ID"
        echo "AZURE_TENANT_ID: $AZURE_TENANT_ID"
        echo "SERVICE ACCOUNT TOKEN FILES:"
        ls -l /var/run/secrets/tokens || echo "No token files found"

        echo
        echo "=== Trying az login with managed identity ==="
        if az login --identity --username "$AZURE_CLIENT_ID"; then
          echo "Login succeeded"
        else
          echo "Login failed"
          exit 1
        fi

        echo
        echo "=== Getting access token for management.azure.com ==="
        if az account get-access-token --resource https://management.azure.com/ --output json > /tmp/uami-token.json; then
          echo "Token fetched successfully:"
          cat /tmp/uami-token.json
        else
          echo "Failed to get access token"
          exit 1
        fi

        echo
        echo "=== Check mounted projected service account token ==="
        TOKEN_FILE=$(find /var/run/secrets/tokens -type f 2>/dev/null | head -n1)
        if [ -n "$TOKEN_FILE" ]; then
          echo "Token file found: $TOKEN_FILE"
          echo "Token contents:"
          cat "$TOKEN_FILE"
        else
          echo "No token file found in /var/run/secrets/tokens"
        fi

        # Keep pod alive for manual inspection
        sleep infinity
        EOF

        chmod +x /tmp/debug-identity.sh
        /tmp/debug-identity.sh
    volumeMounts:
      - name: uami-token
        mountPath: /var/run/secrets
  volumes:
    - name: uami-token
      emptyDir: {}
  restartPolicy: Never
