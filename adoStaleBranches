#🔧 PART 1: Imports, Config & CLI Arguments
import requests
import base64
import logging
import argparse
import urllib3
import csv
from datetime import datetime, timezone
from urllib.parse import quote
from dateutil import parser
from concurrent.futures import ThreadPoolExecutor
from tenacity import retry, stop_after_attempt, wait_exponential

# Disable insecure request warnings
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s",
    handlers=[
        logging.FileHandler("stale_branch_scan.log"),
        logging.StreamHandler()
    ]
)

# CLI arguments
parser = argparse.ArgumentParser(description="Azure DevOps Stale Branch Scanner")
parser.add_argument('--days', type=int, default=30, help='Threshold in days to consider a branch stale')
parser.add_argument('--exclude', nargs='*', default=['main', 'master', 'develop'], help='Branch names to exclude')
parser.add_argument('--output', default='stale_branches.csv', help='Output CSV file name')
parser.add_argument('--delete', action='store_true', default=False, help='Actually delete stale branches')
parser.add_argument('--dry-run', action='store_true', default=False, help='Dry run mode - show branches to delete but do not delete')
args = parser.parse_args()

# ADO Configuration
organization_name = "ADO-XYZ"
project_name = "AA12345-XYZ 2 - PLATFORM-XYZ 2"
personal_access_token = "gwlefgulergure"  # Replace securely

# API Version
api_version = "api-version=7.1-preview.1"

# Encode credentials
base64encoded_pat = base64.b64encode(f":{personal_access_token}".encode()).decode()

# Reuse a single requests session
session = requests.Session()
session.headers.update({
    'Content-Type': 'application/json',
    'Authorization': f'Basic {base64encoded_pat}'
})

#🔧 PART 2: Retry Decorator and Helpers
@retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))
def reliable_get(url):
    response = session.get(url, timeout=30, verify=False)
    response.raise_for_status()
    return response.json()


def encode_url_parts(org, proj):
    return quote(org), quote(proj)


encoded_org_name, encoded_project_name = encode_url_parts(organization_name, project_name)
base_url = f"https://dev.azure.com/{encoded_org_name}/{encoded_project_name}"

#🔧 PART 3: Repo & Branch Fetching + Batch Commit Info
def get_repos():
    url = f"{base_url}/_apis/git/repositories?{api_version}"
    try:
        return reliable_get(url).get('value', [])
    except Exception as e:
        logging.error(f"Failed to fetch repositories: {e}")
        return []


def get_branches(repo_id):
    url = f"{base_url}/_apis/git/repositories/{repo_id}/refs?filter=heads/&{api_version}"
    try:
        return reliable_get(url).get('value', [])
    except Exception as e:
        logging.error(f"Failed to fetch branches for repo {repo_id}: {e}")
        return []


def get_commits_batch(repo_id, commit_ids):
    url = f"{base_url}/_apis/git/repositories/{repo_id}/commitsbatch?{api_version}"
    body = {
        "ids": commit_ids
    }
    try:
        response = session.post(url, json=body, timeout=30, verify=False)
        response.raise_for_status()
        return {item['commitId']: item for item in response.json().get('value', [])}
    except Exception as e:
        logging.error(f"Failed to fetch batch commits: {e}")
        return {}

#🔧 PART 4: Stale Branch Check Logic
def get_stale_branches(repo):
    repo_id = repo['id']
    repo_name = repo['name']
    logging.info(f"Scanning repo: {repo_name}")

    branches = get_branches(repo_id)
    if not branches:
        return []

    commit_ids = [b['objectId'] for b in branches if b.get('objectId')]
    commit_data_map = get_commits_batch(repo_id, commit_ids)

    stale = []
    for branch in branches:
        branch_name = branch['name'].replace("refs/heads/", "")
        if branch_name in args.exclude:
            continue

        commit_id = branch.get('objectId')
        if not commit_id or commit_id not in commit_data_map:
            continue

        commit_info = commit_data_map[commit_id]
        commit_date_str = commit_info.get('committer', {}).get('date')
        try:
            commit_date = parser.parse(commit_date_str)
        except Exception as e:
            logging.warning(f"Failed to parse commit date for branch {branch_name}: {e}")
            continue

        days_old = (datetime.now(timezone.utc) - commit_date).days

        creator_name = branch.get('creator', {}).get('displayName')
        if not creator_name:
            creator_name = commit_info.get('author', {}).get('name', 'Unknown')

        if days_old > args.days:
            stale.append({
                'repo': repo_name,
                'branch': branch_name,
                'date': commit_date_str,
                'days': days_old,
                'creator': creator_name
            })

    return stale

# Add delete branch function (new Part 4.1):
def delete_branch(repo_id, branch_name):
    # Branch name must be full ref path, e.g., refs/heads/feature/oldbranch
    full_ref_name = f"refs/heads/{branch_name}"
    url = f"{base_url}/_apis/git/repositories/{repo_id}/refs?filter={full_ref_name}&{api_version}"

    try:
        # First get the ref object to delete (need its objectId)
        response = session.get(url, timeout=30, verify=False)
        response.raise_for_status()
        refs = response.json().get('value', [])
        if not refs:
            logging.warning(f"Ref {full_ref_name} not found for deletion.")
            return False

        ref_object = refs[0]
        object_id = ref_object['objectId']

        # Delete ref by setting oldObjectId to objectId and newObjectId to 000000...
        delete_url = f"{base_url}/_apis/git/repositories/{repo_id}/refs"
        payload = [{
            "name": full_ref_name,
            "oldObjectId": object_id,
            "newObjectId": "0000000000000000000000000000000000000000"
        }]

        del_response = session.post(delete_url, json=payload, timeout=30, verify=False)
        del_response.raise_for_status()
        logging.info(f"Deleted branch {branch_name} in repo {repo_id}")
        return True
    except Exception as e:
        logging.error(f"Failed to delete branch {branch_name} in repo {repo_id}: {e}")
        return False


#🔧 PART 5: Main Execution + CSV Output
def main():
    repos = get_repos()
    if not repos:
        logging.error("No repositories found.")
        return

    all_stale = []
    with ThreadPoolExecutor(max_workers=5) as executor:
        results = executor.map(get_stale_branches, repos)
        for stale_list in results:
            all_stale.extend(stale_list)

    if all_stale:
        with open(args.output, 'w', newline='') as f:
            writer = csv.DictWriter(f, fieldnames=["repo", "branch", "date", "days", "creator"])
            writer.writeheader()
            writer.writerows(all_stale)
        logging.info(f"✅ {len(all_stale)} stale branches written to {args.output}")

        if args.delete:
            logging.info("🚨 Delete flag detected.")
            for branch in all_stale:
                if args.dry_run:
                    logging.info(f"[Dry Run] Would delete branch '{branch['branch']}' in repo '{branch['repo']}'")
                else:
                    repo_id = next((r['id'] for r in repos if r['name'] == branch['repo']), None)
                    if repo_id:
                        delete_branch(repo_id, branch['branch'])
                    else:
                        logging.error(f"Repo ID not found for {branch['repo']}")
    else:
        logging.info("✅ No stale branches found across all repos.")


if __name__ == "__main__":
    main()

