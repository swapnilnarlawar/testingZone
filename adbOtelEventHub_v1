import io.opentelemetry.api.GlobalOpenTelemetry
import io.opentelemetry.api.common.Attributes
import io.opentelemetry.api.metrics.{Meter, ObservableDoubleMeasurement}
import io.opentelemetry.sdk.metrics.SdkMeterProvider
import io.opentelemetry.sdk.metrics.export.{IntervalMetricReader, MetricExporter}
import io.opentelemetry.exporter.otlp.metrics.OtlpGrpcMetricExporter

import com.azure.messaging.eventhubs._
import com.azure.messaging.eventhubs.EventHubClientBuilder
import com.azure.messaging.eventhubs.EventData
import com.azure.identity.ClientSecretCredentialBuilder

import scala.collection.JavaConverters._
import java.time.Duration

object Main {

  def main(args: Array[String]): Unit = {

    println("=== OpenTelemetry Environment Variables Check ===")
    println("OTEL_EXPORTER_OTLP_ENDPOINT: " + sys.env.getOrElse("OTEL_EXPORTER_OTLP_ENDPOINT", "❌ Not set"))
    println("OTEL_EXPORTER_OTLP_HEADERS: " + sys.env.getOrElse("OTEL_EXPORTER_OTLP_HEADERS", "❌ Not set"))
    println("OTEL_RESOURCE_ATTRIBUTES: " + sys.env.getOrElse("OTEL_RESOURCE_ATTRIBUTES", "❌ Not set"))
    println("================================================")

    // Setup Azure Event Hub
    val tenantId     = sys.env("AZ_TENANT_ID")
    val clientId     = sys.env("AZ_CLIENT_ID")
    val clientSecret = sys.env("AZ_CLIENT_SECRET")
    val namespace    = sys.env("AZ_EVENTHUB_NAMESPACE") // e.g. "xxx.servicebus.windows.net"
    val eventHub     = sys.env("AZ_EVENTHUB_NAME")

    val credential = new ClientSecretCredentialBuilder()
      .tenantId(tenantId)
      .clientId(clientId)
      .clientSecret(clientSecret)
      .build()

    val producer = new EventHubClientBuilder()
      .credential(namespace, eventHub, credential)
      .buildAsyncProducerClient()

    // Create SDK Meter Provider
    val meter: Meter = GlobalOpenTelemetry.getMeter("m922633_otel-databricks-meter")

    // ==============================
    // Metric 1: Single datapoint
    // ==============================
    meter.gaugeBuilder("first_gauge_m922633")
      .setDescription("First gauge metric")
      .buildWithCallback { measurement: ObservableDoubleMeasurement =>
        val value = 42.5
        val attrs = Attributes.builder()
          .put("environment", "dev")
          .put("cmdbReference", "AT12345")
          .build()

        measurement.record(value, attrs)

        // send to Event Hub in OTLP JSON-like format
        val json = s"""{"name":"first_gauge_m922633","value":$value,"environment":"dev","cmdbReference":"AT12345"}"""
        producer.send(Seq(new EventData(json)).asJava).block()
      }

    // ==============================
    // Metric 2: Multi-datapoint Gauge
    // ==============================
    meter.gaugeBuilder("multi_datapoint_metric")
      .setDescription("Multi-datapoint gauge metric")
      .buildWithCallback { measurement: ObservableDoubleMeasurement =>
        val metrics = Seq(
          (77.7, "dev"),
          (88.8, "qa")
        )
        metrics.foreach { case (v, env) =>
          val attrs = Attributes.builder()
            .put("environment", env)
            .put("cmdbReference", "AT12345")
            .build()
          measurement.record(v, attrs)

          // send each metric to Event Hub
          val json = s"""{"name":"multi_datapoint_metric","value":$v,"environment":"$env","cmdbReference":"AT12345"}"""
          producer.send(Seq(new EventData(json)).asJava).block()
        }
      }

    println("✅ Metrics registered and sent to Event Hub in OTLP-like JSON format")
    println("Metrics also available for SDK export via GlobalOpenTelemetry if OTLP collector is attached")
  }
}
