import com.azure.identity.ClientSecretCredentialBuilder
import com.azure.messaging.eventhubs._
import com.azure.messaging.eventhubs.EventHubClientBuilder
import com.azure.messaging.eventhubs.EventData
import io.opentelemetry.proto.collector.metrics.v1.ExportMetricsServiceRequest
import io.opentelemetry.proto.metrics.v1.{Metric, NumberDataPoint, Gauge, InstrumentationLibraryMetrics, ResourceMetrics}
import io.opentelemetry.proto.common.v1.{KeyValue, AnyValue, InstrumentationLibrary, Resource}
import scala.jdk.CollectionConverters._

object EventHubOtelExporter {

  def sendOtelMetrics(namespace: String, eventHub: String, credential: com.azure.core.credential.TokenCredential): Unit = {
    val producer = new EventHubClientBuilder()
      .credential(namespace, eventHub, credential)
      .buildAsyncProducerClient()

    // Helper to build ExportMetricsServiceRequest for a single metric
    def buildExportRequest(metric: Metric): ExportMetricsServiceRequest = {
      val libMetrics = InstrumentationLibraryMetrics(
        instrumentationLibrary = Some(InstrumentationLibrary(name = "eventhub-otel", version = "1.0")),
        metrics = Seq(metric)
      )
      val resourceMetrics = ResourceMetrics(
        resource = Some(Resource(attributes = Seq(KeyValue("service.name", AnyValue("eventhub-demo"))))),
        instrumentationLibraryMetrics = Seq(libMetrics)
      )
      ExportMetricsServiceRequest(resourceMetrics = Seq(resourceMetrics))
    }

    // -------------------------------
    // Metric 1: first_gauge_m922633
    // -------------------------------
    val firstGaugePoint = NumberDataPoint(
      startTimeUnixNano = 0L,
      timeUnixNano = System.currentTimeMillis() * 1000000L,
      value = 42.5
    )

    val firstGaugeMetric = Metric(
      name = "first_gauge_m922633",
      description = "First gauge metric",
      unit = "",
      gauge = Some(Gauge(points = Seq(firstGaugePoint)))
    )

    // Send metric 1
    val export1 = buildExportRequest(firstGaugeMetric)
    producer.send(Seq(new EventData(export1.toByteArray)).asJava).block()
    println("✅ first_gauge_m922633 sent to Event Hub")

    // -------------------------------
    // Metric 2: multi_datapoint_metric
    // -------------------------------
    val multiGaugePoints = Seq(
      NumberDataPoint(
        startTimeUnixNano = 0L,
        timeUnixNano = System.currentTimeMillis() * 1000000L,
        value = 77.7,
        attributes = Seq(
          KeyValue("environment", AnyValue("dev")),
          KeyValue("cmdbReference", AnyValue("AT12345"))
        )
      ),
      NumberDataPoint(
        startTimeUnixNano = 0L,
        timeUnixNano = System.currentTimeMillis() * 1000000L,
        value = 88.8,
        attributes = Seq(
          KeyValue("environment", AnyValue("qa")),
          KeyValue("cmdbReference", AnyValue("AT12345"))
        )
      )
    )

    val multiGaugeMetric = Metric(
      name = "multi_datapoint_metric",
      description = "Gauge metric with multiple datapoints",
      unit = "",
      gauge = Some(Gauge(points = multiGaugePoints))
    )

    // Send metric 2
    val export2 = buildExportRequest(multiGaugeMetric)
    producer.send(Seq(new EventData(export2.toByteArray)).asJava).block()
    println("✅ multi_datapoint_metric sent to Event Hub")

    producer.close()
  }

  def main(args: Array[String]): Unit = {
    val tenantId     = sys.env("AZ_TENANT_ID")
    val clientId     = sys.env("AZ_CLIENT_ID")
    val clientSecret = sys.env("AZ_CLIENT_SECRET")
    val namespace    = sys.env("AZ_EVENTHUB_NAMESPACE")
    val eventHub     = sys.env("AZ_EVENTHUB_NAME")

    val credential = new ClientSecretCredentialBuilder()
      .tenantId(tenantId)
      .clientId(clientId)
      .clientSecret(clientSecret)
      .build()

    sendOtelMetrics(namespace, eventHub, credential)
  }
}
