{
  "title": "Azure SQL Database Complete Overview",
  "uid": "azure-sql-db-complete",
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "database_name",
        "label": "Database",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(mssql_cpu_percent, instance)",
        "regex": "/(^.*sql-megdpsolar.*)(?::\\d+)?/",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "swci",
        "label": "SWCI",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(mssql_cpu_percent, swci)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Resource Utilization",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "type": "gauge",
      "title": "CPU %",
      "targets": [
        { "expr": "avg(mssql_cpu_percent{instance=~\"$database_name\", swci=~\"$swci\"})" }
      ],
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 6 }
    },
    {
      "type": "gauge",
      "title": "Memory %",
      "targets": [
        { "expr": "avg(mssql_memory_usage_percent{instance=~\"$database_name\", swci=~\"$swci\"})" }
      ],
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 6 }
    },
    {
      "type": "gauge",
      "title": "Data IO %",
      "targets": [
        { "expr": "avg(mssql_data_io_percent{instance=~\"$database_name\", swci=~\"$swci\"})" }
      ],
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 6 }
    },
    {
      "type": "gauge",
      "title": "Log Write %",
      "targets": [
        { "expr": "avg(mssql_log_write_percent{instance=~\"$database_name\", swci=~\"$swci\"})" }
      ],
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 6 }
    },
    {
      "type": "row",
      "title": "Connections & Workload",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "Active Connections",
      "targets": [
        { "expr": "mssql_active_connections{instance=~\"$database_name\", swci=~\"$swci\"}" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "swci" },
            "properties": [{ "id": "color", "value": { "mode": "palette-classic" } }]
          }
        ]
      },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Active Requests",
      "targets": [
        { "expr": "mssql_active_requests{instance=~\"$database_name\", swci=~\"$swci\"}" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "swci" },
            "properties": [{ "id": "color", "value": { "mode": "palette-classic" } }]
          }
        ]
      },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Blocked Sessions",
      "targets": [
        { "expr": "mssql_blocked_sessions{instance=~\"$database_name\", swci=~\"$swci\"}" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "swci" },
            "properties": [{ "id": "color", "value": { "mode": "palette-classic" } }]
          }
        ]
      },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 6 }
    },
    {
      "type": "row",
      "title": "Wait Statistics",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 }
    },
    {
      "type": "bargauge",
      "title": "Top Waits (by time)",
      "targets": [
        { "expr": "topk(5, sum by (wait_type) (mssql_wait_time_ms{instance=~\"$database_name\", swci=~\"$swci\"}))" }
      ],
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 6 }
    },
    {
      "type": "row",
      "title": "Query Store Insights",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 }
    },
    {
      "type": "table",
      "title": "Top Queries by CPU",
      "targets": [
        { "expr": "topk(10, sum by(query_hash) (mssql_query_stats_cpu_time_ms{instance=~\"$database_name\", swci=~\"$swci\"}))" }
      ],
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 6 }
    },
    {
      "type": "row",
      "title": "Storage & IO",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "DB File Sizes (MB)",
      "targets": [
        { "expr": "mssql_db_file_size_kb{instance=~\"$database_name\", swci=~\"$swci\"} / 1024" }
      ],
      "gridPos": { "x": 0, "y": 35, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "File IO Stalls (ms)",
      "targets": [
        { "expr": "mssql_file_io_stall_ms{instance=~\"$database_name\", swci=~\"$swci\"}" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "swci" },
            "properties": [{ "id": "color", "value": { "mode": "palette-classic" } }]
          }
        ]
      },
      "gridPos": { "x": 12, "y": 35, "w": 12, "h": 6 }
    },
    {
      "type": "row",
      "title": "Reliability & Errors",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 41, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "Deadlocks/sec",
      "targets": [
        { "expr": "mssql_deadlocks{instance=~\"$database_name\", swci=~\"$swci\"}" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "swci" },
            "properties": [{ "id": "color", "value": { "mode": "palette-classic" } }]
          }
        ]
      },
      "gridPos": { "x": 0, "y": 42, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Errors/sec",
      "targets": [
        { "expr": "mssql_errors{instance=~\"$database_name\", swci=~\"$swci\"}" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "swci" },
            "properties": [{ "id": "color", "value": { "mode": "palette-classic" } }]
          }
        ]
      },
      "gridPos": { "x": 12, "y": 42, "w": 12, "h": 6 }
    },
    {
      "type": "row",
      "title": "Elastic Pool Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 }
    },
    {
      "type": "gauge",
      "title": "Elastic Pool CPU (%)",
      "targets": [
        { "expr": "avg(mssql_elastic_pool_cpu_percent{swci=~\"$swci\"})" }
      ],
      "gridPos": { "x": 0, "y": 49, "w": 6, "h": 6 }
    },
    {
      "type": "gauge",
      "title": "Elastic Pool Data IO (%)",
      "targets": [
        { "expr": "avg(mssql_elastic_pool_data_io_percent{swci=~\"$swci\"})" }
      ],
      "gridPos": { "x": 6, "y": 49, "w": 6, "h": 6 }
    }
  ]
}
