            )
            
            stats.conflicts = len(conflicts)
            stats.additions = len(set(cfgB.keys()) - set(cfgA.keys()))
            stats.preserved = len(set(cfgA.keys()) & set(cfgB.keys())) - len(conflicts)
            
            if args.diff and not args.dry_run:
                cfgMerged, _, _ = parse_config_lines(args.output)
                print_context_diff(cfgA, cfgB, cfgMerged)
            
            if args.json:
                print(json.dumps(stats.to_dict(), indent=2))
            elif args.verbose or not args.show_warnings_only:
                stats.print_summary()
            
            # Exit with error if strict mode and conflicts exist
            if args.strict and conflicts:
                logging.error(f"Strict mode: {len(conflicts)} conflicts detected")
                sys.exit(1)
                
        except Exception as e:
            logging.error(f"Merge failed: {e}")
            sys.exit(1)
