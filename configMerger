        export VAR1='A1' # comment1
        export VAR2='' 
        export VAR3='keep' # keep me
        """)
    configB = textwrap.dedent("""\
        export VAR1='B1'
        export VAR2='B2'
        export VAR4='B4'
        """)
    
    with tempfile.TemporaryDirectory() as tmp:
        a = os.path.join(tmp, "A.sh")
        b = os.path.join(tmp, "B.sh")
        o = os.path.join(tmp, "out.sh")
        
