                        help="Path to configuration file (default: .configmergerrc)")
    
    args = parser.parse_args()
    
    # Load RC file configuration
    rc_config = load_config_file(args.config)
    
    # Override with RC file values if not specified on command line
    for key, value in rc_config.items():
        arg_name = key.replace('-', '_')
        if hasattr(args, arg_name) and getattr(args, arg_name) == parser.get_default(key.replace('_', '-')):
            setattr(args, arg_name, value)
    
