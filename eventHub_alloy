# ============================
# Prometheus Azure Exporter
# ============================
prometheus.exporter.azure integrations_azure_exporter {
  subscriptions  = ["<your-subscription-id>"]
  resource_type  = "Microsoft.EventHub/namespaces"
  metrics        = ["IncomingMessages", "OutgoingMessages", "IncomingBytes", "OutgoingBytes", "ServerErrors", "UserErrors"]
  regions        = ["eastus"]   # optional, set your EventHub region
}

# ============================
# Prometheus Scrape Job
# ============================
prometheus.scrape integrations_azure_exporter {
  targets     = prometheus.exporter.azure.integrations_azure_exporter.targets
  forward_to  = [exporter.otlphttp.mimir]
  job_name    = "integrations/azure_exporter"
}

# ============================
# Attributes Processor (optional)
# ============================
processor attributes default {
  action {
    action = upsert
    key    = cmdbReference
    value  = "AT12345"
  }
}

# ============================
# Batch Processor (optional)
# ============================
processor batch default {
  timeout         = "10s"
  send_batch_size = 1000
}

# ============================
# OTLP HTTP Exporter (Mimir)
# ============================
exporter otlphttp mimir {
  client {
    endpoint = "https://<mimir-endpoint>/otlp/v1/metrics"

    headers = {
      X-Scope-OrgID = "234628-23492-13"
    }

    tls {
      insecure_skip_verify = true
    }
  }
}

# ============================
# Service Pipeline
# ============================
service default {
  pipelines {
    metrics = [
      processor.attributes.default,
      processor.batch.default,
      exporter.otlphttp.mimir
    ]
  }
}
