# Grafana Alloy configuration for Azure Event Hub metrics
# Combining Azure Monitor metrics + Custom Event Hub consumer
# Using User-Assigned Managed Identity (UAMI) authentication
# Save this as config.alloy

// Option 1: Azure Monitor exporter for Event Hub built-in metrics
prometheus.exporter.azure "eventhub_monitor" {
  // Using UAMI - no credentials needed when running in Azure with managed identity
  subscription_id = env("AZURE_SUBSCRIPTION_ID")
  
  // Optionally specify resource groups to limit scope
  resource_groups = [env("EVENTHUB_RESOURCE_GROUP")]
  
  // Focus on Event Hub resources
  resource_types = [
    "Microsoft.EventHub/namespaces"
  ]
  
  // Event Hub specific metrics from Azure Monitor
  metrics = [
    {
      name = "IncomingMessages"
      aggregations = ["Total", "Average"]
      dimensions = ["EntityName"]
    },
    {
      name = "OutgoingMessages" 
      aggregations = ["Total", "Average"]
      dimensions = ["EntityName"]
    },
    {
      name = "IncomingBytes"
      aggregations = ["Total", "Average"] 
      dimensions = ["EntityName"]
    },
    {
      name = "OutgoingBytes"
      aggregations = ["Total", "Average"]
      dimensions = ["EntityName"]
    },
    {
      name = "ActiveConnections"
      aggregations = ["Average", "Maximum"]
      dimensions = ["*"]
    },
    {
      name = "ConnectionsOpened"
      aggregations = ["Total"]
      dimensions = ["*"]
    },
    {
      name = "ConnectionsClosed" 
      aggregations = ["Total"]
      dimensions = ["*"]
    },
    {
      name = "CaptureBacklog"
      aggregations = ["Average"]
      dimensions = ["PartitionId", "EntityName"]
    },
    {
      name = "ArchiveBacklog"
      aggregations = ["Average"] 
      dimensions = ["EntityName"]
    },
    {
      name = "Size"
      aggregations = ["Average"]
      dimensions = ["EntityName"]
    },
    {
      name = "INREQS"
      aggregations = ["Total"]
      dimensions = ["EntityName", "OperationResult"]
    },
    {
      name = "SUCCREQ"
      aggregations = ["Total"] 
      dimensions = ["EntityName", "OperationResult"]
    },
    {
      name = "FAILREQ"
      aggregations = ["Total"]
      dimensions = ["EntityName", "OperationResult"] 
    },
    {
      name = "SVRBSY"
      aggregations = ["Total"]
      dimensions = ["EntityName", "OperationResult"]
    },
    {
      name = "INTERR" 
      aggregations = ["Total"]
      dimensions = ["EntityName", "OperationResult"]
    },
    {
      name = "MISCERR"
      aggregations = ["Total"]
      dimensions = ["EntityName", "OperationResult"]
    },
    {
      name = "INMSGS"
      aggregations = ["Total"]
      dimensions = ["EntityName"]
    },
    {
      name = "EHINMSGS"
      aggregations = ["Total"] 
      dimensions = ["EntityName"]
    },
    {
      name = "OUTMSGS"
      aggregations = ["Total"]
      dimensions = ["EntityName"]
    },
    {
      name = "EHOUTMSGS"
      aggregations = ["Total"]
      dimensions = ["EntityName"]
    },
    {
      name = "UserErrors"
      aggregations = ["Total"]
      dimensions = ["EntityName", "OperationResult"]
    },
    {
      name = "ServerErrors"
      aggregations = ["Total"]
      dimensions = ["EntityName", "OperationResult"]
    },
    {
      name = "QuotaExceededErrors"
      aggregations = ["Total"]
      dimensions = ["EntityName", "OperationResult"]
    },
    {
      name = "ThrottledRequests"
      aggregations = ["Total"]
      dimensions = ["EntityName", "OperationResult"]
    }
  ]
  
  scrape_interval = "60s"
}

// Scrape Azure Monitor metrics and send to your pipeline
prometheus.scrape "eventhub_azure_monitor" {
  targets = prometheus.exporter.azure.eventhub_monitor.targets
  forward_to = [prometheus.relabel.eventhub_monitor_labels.receiver]
  scrape_interval = "60s"
  job_name = "azure-eventhub-monitor"
  
  // Increase timeout for Azure Monitor API calls
  scrape_timeout = "50s"
}

// Add custom labels to Azure Monitor metrics
prometheus.relabel "eventhub_monitor_labels" {
  forward_to = [prometheus.remote_write.mimir.receiver]
  
  rule {
    source_labels = ["__meta_azure_resource_group"]
    target_label = "resource_group"
  }
  
  rule {
    source_labels = ["__meta_azure_resource_name"] 
    target_label = "eventhub_namespace"
  }
  
  rule {
    source_labels = ["__meta_azure_location"]
    target_label = "azure_region"
  }
  
  rule {
    source_labels = ["__name__"]
    regex = "azure_(.+)"
    target_label = "metric_source"
    replacement = "azure_monitor"
  }
  
  // Add your organizational labels
  rule {
    target_label = "enrichedBy"
    replacement = "centralAlloy"
  }
  
  rule {
    target_label = "cmdbReference"
    replacement = env("CMDB_REFERENCE")
  }
  
  rule {
    target_label = "cluster"
    replacement = env("AKS_ID")
  }
  
  rule {
    target_label = "tenant"
    replacement = env("TENANT_ID")
  }
}

// Option 2: OpenTelemetry Event Hub receiver for custom application metrics
otelcol.receiver.azureeventhub "custom_metrics" {
  // UAMI authentication - specify the namespace endpoint
  endpoint = env("EVENTHUB_NAMESPACE") + ".servicebus.windows.net"
  eventhub_name = env("EVENTHUB_NAME")
  consumer_group = "$Default"
  
  // Use User-Assigned Managed Identity
  auth {
    managed_identity {
      client_id = env("UAMI_CLIENT_ID")  // Optional: specify UAMI client ID if multiple identities
    }
  }
  
  // Partition configuration
  partition {
    checkpoint_interval = "10s"
    receive_timeout = "60s"
  }
  
  output {
    logs = [otelcol.processor.transform.eventhub_logs.input]
    metrics = [otelcol.processor.transform.eventhub_metrics.input]
    traces = [otelcol.processor.transform.eventhub_traces.input]
  }
}

// Option 2: OpenTelemetry Event Hub receiver for custom application metrics
otelcol.receiver.azureeventhub "custom_metrics" {
  // UAMI authentication - specify the namespace endpoint
  endpoint = env("EVENTHUB_NAMESPACE") + ".servicebus.windows.net"
  eventhub_name = env("EVENTHUB_NAME")
  consumer_group = "$Default"
  
  // Use User-Assigned Managed Identity
  auth {
    managed_identity {
      client_id = env("UAMI_CLIENT_ID")  // Optional: specify UAMI client ID if multiple identities
    }
  }
  
  // Partition configuration
  partition {
    checkpoint_interval = "10s"
    receive_timeout = "60s"
  }
  
  output {
    logs    = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input] 
    traces  = [otelcol.processor.batch.default.input]
  }
}

// Transform Event Hub log messages into custom metrics
otelcol.processor.transform "eventhub_logs" {
  error_mode = "ignore"
  
  log_statements {
    context = "log"
    statements = [
      // Parse JSON messages and extract custom metrics
      "set(attributes[\"event_type\"], ParseJSON(body)[\"eventType\"]) where IsString(body)",
      "set(attributes[\"source_system\"], ParseJSON(body)[\"source\"]) where IsString(body)",
      "set(attributes[\"application\"], ParseJSON(body)[\"application\"]) where IsString(body)",
      "set(attributes[\"severity\"], ParseJSON(body)[\"severity\"]) where IsString(body)",
      "set(attributes[\"custom_value\"], ParseJSON(body)[\"value\"]) where IsString(body)",
      "set(attributes[\"partition_id\"], resource.attributes[\"partition.id\"])",
      "set(attributes[\"eventhub_name\"], resource.attributes[\"eventhub.name\"])",
      "set(attributes[\"eventhub_namespace\"], resource.attributes[\"eventhub.namespace\"])",
      
      // Create metrics from log content
      "set(attributes[\"message_count\"], 1)",
      "set(attributes[\"message_size\"], len(body)) where IsString(body)",
    ]
  }
  
  output {
    logs = [otelcol.connector.logs.custom_metrics.input]
  }
}

// Transform existing metrics from Event Hub
otelcol.processor.transform "eventhub_metrics" {
  error_mode = "ignore"
  
  metric_statements {
    context = "metric" 
    statements = [
      // Add custom labels to metrics
      "set(attributes[\"eventhub_namespace\"], resource.attributes[\"eventhub.namespace\"])",
      "set(attributes[\"eventhub_name\"], resource.attributes[\"eventhub.name\"])",
      "set(attributes[\"consumer_group\"], resource.attributes[\"eventhub.consumer_group\"])",
      "set(attributes[\"partition_id\"], resource.attributes[\"partition.id\"])",
      "set(attributes[\"metric_source\"], \"eventhub_consumer\")",
    ]
  }
  
  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

// Handle traces if any
otelcol.processor.transform "eventhub_traces" {
  error_mode = "ignore"
  
  trace_statements {
    context = "span"
    statements = [
      "set(attributes[\"eventhub_namespace\"], resource.attributes[\"eventhub.namespace\"])",
      "set(attributes[\"eventhub_name\"], resource.attributes[\"eventhub.name\"])",
    ]
  }
  
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// Convert logs to custom metrics
otelcol.connector.logs "custom_metrics" {
  // Convert log events to metrics based on attributes
  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

// Health check endpoint - send to Mimir as well
prometheus.exporter.self "alloy_health" {
}

prometheus.scrape "alloy_health" {
  targets = prometheus.exporter.self.alloy_health.targets
  forward_to = [prometheus.remote_write.mimir.receiver]
  job_name = "alloy-health"
  scrape_interval = "30s"
}

// Authentication for multi-tenant setup
otelcol.auth.headers "creds" {
  header {
    key   = "X-Scope-OrgID"
    value = env("X_SCOPE_ORG_ID")
  }
}

// Batch processor for better performance
otelcol.processor.batch "default" {
  metadata_keys      = ["X-Scope-OrgID"]
  timeout           = "10s"
  send_batch_size   = 1000
  
  output {
    traces  = [otelcol.processor.attributes.enrich_alloy_labels.input]
    metrics = [otelcol.processor.attributes.enrich_alloy_labels.input]
    logs    = [otelcol.processor.attributes.enrich_alloy_labels.input]
  }
}

// Enrich with standardized labels for your organization
otelcol.processor.attributes "enrich_alloy_labels" {
  action {
    action = "insert"
    key    = "enrichedBy"
    value  = "centralAlloy"
  }
  
  action {
    action = "insert"
    key    = "cmdbReference"
    value  = env("CMDB_REFERENCE")
  }
  
  action {
    action = "insert"
    key    = "cluster"
    value  = env("AKS_ID")
  }
  
  action {
    action = "insert"
    key    = "data_source"
    value  = "azure_eventhub"
  }
  
  action {
    action = "insert"
    key    = "tenant"
    value  = env("TENANT_ID")
  }
  
  output {
    metrics = [otelcol.processor.transform.convert_resources.input]
    logs    = [otelcol.processor.transform.convert_resources.input]
    traces  = [otelcol.processor.transform.convert_resources.input]
  }
}

// Convert resource attributes to datapoint/log attributes
otelcol.processor.transform "convert_resources" {
  error_mode = "ignore"
  
  metric_statements {
    context = "datapoint"
    statements = [
      `merge_maps(attributes, resource.attributes, "insert")`,
    ]
  }
  
  log_statements {
    context = "log"
    statements = [
      `merge_maps(attributes, resource.attributes, "insert")`,
    ]
  }
  
  output {
    metrics = [otelcol.exporter.otlphttp.otelcol.input]
    logs    = [otelcol.exporter.otlphttp.otelcol.input]
    traces  = [otelcol.exporter.otlphttp.otelcol.input]
  }
}

// Primary OTLP exporter to your central collector
otelcol.exporter.otlphttp "otelcol" {
  client {
    endpoint = env("OTELCOL_URL")
    auth     = otelcol.auth.headers.creds.handler
    
    tls {
      insecure             = true
      insecure_skip_verify = true
    }
  }
}

// Secondary OTLP exporter (backup/additional endpoint)
otelcol.exporter.otlphttp "default" {
  client {
    endpoint = "https://otelcol.test.net"
    headers = {
      "X-Scope-OrgID" = env("TENANT_ID")
    }
    
    tls {
      insecure_skip_verify = true
    }
  }
}

// Remote write to Mimir for Prometheus metrics
prometheus.remote_write "mimir" {
  endpoint {
    url = "https://mimir.test.net/api/v1/push"
    
    headers = {
      "X-Scope-OrgID" = env("X_SCOPE_ORG_ID")
      "X-Source"      = "grafana-alloy-eventhub"
      "X-Environment" = env("ENVIRONMENT")
    }
    
    tls_config {
      insecure_skip_verify = true
    }
    
    // Queue configuration for high throughput
    queue_config {
      capacity                = 20000
      max_shards             = 100
      batch_send_deadline    = "5s"
      max_samples_per_send   = 2000
    }
    
    // Retry configuration
    retry_on_http_429 = true
    
    // Write relabeling to add organizational metadata
    write_relabel_configs = [
      {
        source_labels = ["__name__"]
        regex         = "up|scrape_.*"
        action        = "drop"
      },
      {
        target_label = "enrichedBy"
        replacement  = "centralAlloy"
      },
      {
        target_label = "cmdbReference"
        replacement  = env("CMDB_REFERENCE")
      },
      {
        target_label = "cluster"
        replacement  = env("AKS_ID")
      },
      {
        target_label = "tenant"
        replacement  = env("TENANT_ID")
      }
    ]
  }
}

// Logging configuration  
logging {
  level = env("LOG_LEVEL")
  format = "json"
}
