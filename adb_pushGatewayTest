aggMap.foreach { case (metricName, metricValue) =>
  val safeName = metricName.replaceAll("[^a-zA-Z0-9_]", "_") // make it Prometheus-safe
  Gauge.build()
    .name(s"spark_${safeName}")
    .help(s"Spark metric: $metricName")
    .register(registry)
    .set(metricValue.toDouble)
}

// Push metrics to Pushgateway
new PushGateway(pushGatewayURL).pushAdd(registry, jobName)

println(s"✅ ${aggMap.size} Spark metrics pushed to $pushGatewayURL/job/$jobName")
