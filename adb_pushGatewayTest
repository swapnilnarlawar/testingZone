import ch.cern.sparkmeasure.FlightRecorderStageMetrics
import io.prometheus.client.{CollectorRegistry, Gauge}
import io.prometheus.client.exporter.PushGateway
import org.apache.spark.sql.functions._

// ----------------------
// Step 1: Initialize Flight Recorder
// ----------------------
val fr = new FlightRecorderStageMetrics(spark)
fr.start()

// ----------------------
// Step 2: Run some Spark workload
// ----------------------
val df = spark.range(1e6.toLong).withColumn("square", col("id") * col("id"))
df.agg(avg("square")).show()

fr.stop()

// ----------------------
// Step 3: Get Flight Recorder JSON
// ----------------------
val jsonString: String = fr.getAllEventsJSON()

// Save to DBFS for debugging (optional)
dbutils.fs.put("dbfs:/tmp/flight_recorder.json", jsonString, true)

println("✅ Captured Flight Recorder JSON")

// ----------------------
// Step 4: Parse JSON into DataFrame
// ----------------------
val jsonDF = spark.read.option("multiline", "true").json(Seq(jsonString).toDS)
val stagesDF = jsonDF.selectExpr("explode(events) as event").select("event.*")

println("=== Parsed Events ===")
stagesDF.show(false)

// ----------------------
// Step 5: Push a couple metrics to Pushgateway
// ----------------------
val registry = new CollectorRegistry()
val pushGatewayURL = "http://pushgateway.example.com"  // ingress in AKS
val jobName = "spark_databricks_flight_recorder"

// Example: capture duration + task count
stagesDF.select("stageId","numTasks","executorRunTime").collect().foreach { row =>
  val stageId = row.getAs[Long]("stageId")
  val numTasks = row.getAs[Long]("numTasks")
  val duration = row.getAs[Double]("executorRunTime")

  val taskGauge = Gauge.build()
    .name(s"spark_stage_${stageId}_task_count")
    .help(s"Number of tasks in stage $stageId")
    .register(registry)
  taskGauge.set(numTasks.toDouble)

  val durationGauge = Gauge.build()
    .name(s"spark_stage_${stageId}_executor_runtime_ms")
    .help(s"Executor runtime (ms) in stage $stageId")
    .register(registry)
  durationGauge.set(duration)
}

val pg = new PushGateway(pushGatewayURL)
pg.pushAdd(registry, jobName)

println(s"✅ Metrics pushed to Pushgateway at $pushGatewayURL/job/$jobName")
