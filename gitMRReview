import gitlab
import xlsxwriter
import logging
import re
from collections import defaultdict
import urllib3
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor, as_completed

# -------------------------------
# CONFIGURATION
# -------------------------------
GITLAB_URL = "https://your-gitlab-server"
PRIVATE_TOKEN = "YOUR_PRIVATE_TOKEN"
GROUP_ID = 987654       # preferred numeric group ID
RELEASE_NAME = "ABC"    # release identifier
USE_TIMESTAMP = True    # add timestamp to Excel filename
OUTPUT_FILE_BASE = "gitlab_pipeline_summary.xlsx"
SSL_VERIFY = False
LOG_LEVEL = logging.INFO
MAX_THREADS = 10  # threads for parallel pipeline/job fetching
# -------------------------------

# Timestamped output file
if USE_TIMESTAMP:
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    OUTPUT_FILE = OUTPUT_FILE_BASE.replace(".xlsx", f"_{timestamp}.xlsx")
else:
    OUTPUT_FILE = OUTPUT_FILE_BASE

# Disable SSL warnings if necessary
if not SSL_VERIFY:
    urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# Regex for release branch matching
release_pattern = re.compile(rf"release[-/]{RELEASE_NAME}", re.IGNORECASE)

# Logging
logging.basicConfig(level=LOG_LEVEL, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger(__name__)

# Connect to GitLab
gl = gitlab.Gitlab(GITLAB_URL, private_token=PRIVATE_TOKEN, ssl_verify=SSL_VERIFY)
gl.auth()
logger.info("Connected to GitLab")

group = gl.groups.get(GROUP_ID)

# Data storage
mr_dict = defaultdict(lambda: {
    "Project": "",
    "MR_ID": "",
    "MR_Title": "",
    "MR_URL": "",
    "Author": "",
    "LastUpdated": None,
    "Pipelines": {}  # pipeline_id -> {'url':..., 'status':..., 'jobs':[ (stage, job, url, status) ]}
})

# -------------------------------
# Helper: fetch jobs for a pipeline
# -------------------------------
def fetch_pipeline_jobs(proj_id, pipeline_id):
    try:
        proj = gl.projects.get(proj_id)
        pipeline = proj.pipelines.get(pipeline_id)
        if pipeline.status == "success":
            return None  # skip successful pipelines
        # Fetch failed/skipped/canceled/manual jobs
        jobs = pipeline.jobs.list(scope=['failed','skipped','canceled','manual'], all=True)
        job_summaries = []
        for job in jobs:
            job_summaries.append((
                job.stage,
                job.name,
                job.web_url,
                job.status
            ))
        if not job_summaries:
            return None
        return pipeline.id, pipeline.web_url, pipeline.status, job_summaries
    except Exception as e:
        logger.warning(f"Error fetching jobs for pipeline {pipeline_id} in project {proj_id}: {e}")
        return None

# -------------------------------
# Process projects
# -------------------------------
for project in group.projects.list(all=True, include_subgroups=True):
    try:
        proj = gl.projects.get(project.id)
        logger.info(f"Processing project: {proj.path_with_namespace}")
    except Exception as e:
        logger.warning(f"Skipping project {project.id}: {e}")
        continue

    # Step 1: list branches matching release pattern
    try:
        branches = [b.name for b in proj.branches.list(all=True) if re.search(r'release[-/]', b.name, re.I)]
        release_branches = [b for b in branches if release_pattern.search(b)]
        if not release_branches:
            logger.info(f"No release branches found for {proj.path_with_namespace}")
            continue
    except Exception as e:
        logger.warning(f"Failed to list branches: {e}")
        continue

    # Step 2: list MRs targeting these release branches
    for branch in release_branches:
        try:
            mrs = proj.mergerequests.list(state='merged', target_branch=branch, all=True)
        except Exception as e:
            logger.warning(f"Failed to list MRs for branch {branch}: {e}")
            continue

        for mr in mrs:
            if not mr.merge_commit_sha:
                continue

            # Console output
            print(f"Found MR: !{mr.iid} | Title: {mr.title} | Author: {mr.author.get('username','unknown')} | Target branch: {mr.target_branch}")

            key = (proj.name, mr.iid)
            mr_entry = mr_dict[key]
            mr_entry.update({
                "Project": proj.name,
                "MR_ID": mr.iid,
                "MR_Title": mr.title,
                "MR_URL": mr.web_url,
                "Author": mr.author.get('username','unknown'),
                "LastUpdated": datetime.fromisoformat(mr.updated_at.replace("Z", "+00:00")) if mr.updated_at else None
            })

            # Step 3: fetch pipelines for MR's merge commit
            try:
                pipelines = proj.pipelines.list(sha=mr.merge_commit_sha, all=True)
            except Exception as e:
                logger.warning(f"Failed to list pipelines for MR !{mr.iid}: {e}")
                continue

            # Step 4: fetch pipeline jobs in parallel
            with ThreadPoolExecutor(max_workers=MAX_THREADS) as executor:
                future_to_pid = {executor.submit(fetch_pipeline_jobs, proj.id, pipe.id): pipe.id for pipe in pipelines}
                for future in as_completed(future_to_pid):
                    result = future.result()
                    if result:
                        pid, p_url, p_status, job_summaries = result
                        mr_entry["Pipelines"][pid] = {
                            "url": p_url,
                            "status": p_status,
                            "jobs": job_summaries
                        }

            # Skip MR if no pipelines had problematic jobs
            if not mr_entry["Pipelines"]:
                logger.info(f"Skipping MR !{mr.iid} in project {proj.name} because all pipelines are successful")
                del mr_dict[key]  # remove from dict
                continue

# -------------------------------
# Export to Excel
# -------------------------------
workbook = xlsxwriter.Workbook(OUTPUT_FILE)
worksheet = workbook.add_worksheet("Summary")

headers = ["Project", "MR ID", "MR Title", "Author", "Last Updated", "MR URL", "Pipeline", "Pipeline Status", "Problematic Job"]
header_fmt = workbook.add_format({'bold': True, 'bg_color':'#D7E4BC', 'text_wrap': True})
wrap_fmt = workbook.add_format({'text_wrap': True})
datetime_fmt = workbook.add_format({'num_format':'yyyy-mm-dd hh:mm:ss', 'text_wrap': True})

for col, header in enumerate(headers):
    worksheet.write(0, col, header, header_fmt)

row = 1
for mr_entry in mr_dict.values():
    for pid, pdata in mr_entry["Pipelines"].items():
        for stage, job_name, job_url, job_status in pdata["jobs"]:
            worksheet.write(row, 0, mr_entry["Project"], wrap_fmt)
            worksheet.write(row, 1, mr_entry["MR_ID"], wrap_fmt)
            worksheet.write(row, 2, mr_entry["MR_Title"], wrap_fmt)
            worksheet.write(row, 3, mr_entry["Author"], wrap_fmt)
            if mr_entry["LastUpdated"]:
                worksheet.write_datetime(row, 4, mr_entry["LastUpdated"], datetime_fmt)
            else:
                worksheet.write(row, 4, "N/A", wrap_fmt)
            worksheet.write_url(row, 5, mr_entry["MR_URL"], string=f"!{mr_entry['MR_ID']}", cell_format=wrap_fmt)

            worksheet.write_url(row, 6, pdata["url"], string=str(pid), cell_format=wrap_fmt)
            worksheet.write(row, 7, pdata["status"], wrap_fmt)
            worksheet.write_url(row, 8, job_url, string=f"{stage}: {job_name} ({job_status})", cell_format=wrap_fmt)

            row +=1

workbook.close()
logger.info(f"✅ Exported Excel summary to {OUTPUT_FILE}")
