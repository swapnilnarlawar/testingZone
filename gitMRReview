import gitlab
import logging
import re
import urllib3
import xlsxwriter
from concurrent.futures import ThreadPoolExecutor, as_completed

# ------------------- CONFIG -------------------
GITLAB_URL = "https://gitlab.example.com"
GITLAB_TOKEN = "YOUR_TOKEN"
GROUP_NAME = "your-group-name"
OUTPUT_FILE = "merge_requests_report.xlsx"
MAX_WORKERS = 10  # parallel threads
# ----------------------------------------------

# Disable SSL warnings (insecure mode)
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# Logging
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger(__name__)

# Connect to GitLab
gl = gitlab.Gitlab(GITLAB_URL, private_token=GITLAB_TOKEN, ssl_verify=False)

# Regex for release branches (case-insensitive, matches "release", "Release", "release-abc", "release/abc")
RELEASE_PATTERN = re.compile(r"(?:^|/)(release[-/]?.*)", re.IGNORECASE)


def fetch_project_mrs(proj):
    """Fetch all MRs targeting release branches for a project."""
    try:
        mrs = proj.mergerequests.list(state="opened", all=True)
    except Exception as e:
        logger.error(f"Failed to fetch MRs for {proj.name}: {e}")
        return []

    valid_mrs = []
    for mr in mrs:
        target_branch = mr.target_branch or ""
        if RELEASE_PATTERN.search(target_branch):
            valid_mrs.append(mr)
    return valid_mrs


def fetch_pipeline_jobs(pipeline):
    """Fetch all jobs for a given pipeline."""
    try:
        return pipeline.jobs.list(all=True)
    except Exception as e:
        logger.error(f"Failed to fetch jobs for pipeline {pipeline.id}: {e}")
        return []


def main():
    group = gl.groups.get(GROUP_NAME)
    projects = group.projects.list(all=True)

    all_mr_data = []

    logger.info(f"Found {len(projects)} projects in group {GROUP_NAME}")

    for proj_info in projects:
        proj = gl.projects.get(proj_info.id)
        mrs = fetch_project_mrs(proj)

        if not mrs:
            continue

        logger.info(f"Project {proj.name}: Found {len(mrs)} release MRs")

        for mr in mrs:
            logger.info(f"  MR !{mr.iid} - {mr.title} (branch {mr.target_branch})")

            pipelines = []
            try:
                pipelines = mr.pipelines.list(all=True)
            except Exception as e:
                logger.error(f"    Failed to fetch pipelines for MR !{mr.iid}: {e}")
                continue

            problematic_jobs = []
            pipeline_ids = []
            pipeline_urls = []

            with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
                future_jobs = {
                    executor.submit(fetch_pipeline_jobs, pipeline): pipeline
                    for pipeline in pipelines
                }

                for future in as_completed(future_jobs):
                    pipeline = future_jobs[future]
                    try:
                        jobs = future.result()
                    except Exception:
                        continue

                    # Only include failed/skipped/canceled/manual jobs
                    bad_jobs = [
                        (job.stage, job.name, job.web_url)
                        for job in jobs
                        if job.status in ("failed", "skipped", "canceled", "manual")
                    ]

                    if bad_jobs:
                        pipeline_ids.append(str(pipeline.id))
                        pipeline_urls.append(pipeline.web_url)
                        problematic_jobs.extend(bad_jobs)

            if not problematic_jobs:
                logger.info(f"    Skipping MR !{mr.iid} (all pipelines successful)")
                continue

            all_mr_data.append({
                "Project": proj.name,
                "MR_ID": mr.iid,
                "MR_Title": mr.title,
                "MR_URL": mr.web_url,
                "PipelineIDs": pipeline_ids,
                "PipelineURLs": pipeline_urls,
                "ProblematicJobs": problematic_jobs,
            })

            # Debug print to console
            logger.info(f"    MR !{mr.iid} has {len(problematic_jobs)} problematic jobs")
            for stage, job, url in problematic_jobs:
                logger.info(f"      - {stage}: {job} ({url})")

    # ---------------- Excel Export ----------------
    workbook = xlsxwriter.Workbook(OUTPUT_FILE)
    worksheet = workbook.add_worksheet("MR Pipelines")

    headers = [
        "Project",
        "MR ID",
        "MR Title",
        "MR URL",
        "Pipelines",
        "Problematic Job"
    ]

    header_fmt = workbook.add_format({"bold": True, "bg_color": "#D7E4BC", "text_wrap": True})
    wrap_fmt = workbook.add_format({"text_wrap": True})

    for col, h in enumerate(headers):
        worksheet.write(0, col, h, header_fmt)

    row = 1
    for mr_entry in all_mr_data:
        for stage, job, url in mr_entry["ProblematicJobs"]:
            worksheet.write(row, 0, mr_entry["Project"], wrap_fmt)
            worksheet.write(row, 1, mr_entry["MR_ID"], wrap_fmt)
            worksheet.write(row, 2, mr_entry["MR_Title"], wrap_fmt)
            worksheet.write_url(row, 3, mr_entry["MR_URL"], string="Link", cell_format=wrap_fmt)

            if mr_entry["PipelineIDs"]:
                pipeline_links = [
                    f"{pid} ({purl})"
                    for pid, purl in zip(mr_entry["PipelineIDs"], mr_entry["PipelineURLs"])
                ]
                worksheet.write(row, 4, ", ".join(pipeline_links), wrap_fmt)
            else:
                worksheet.write(row, 4, "N/A", wrap_fmt)

            worksheet.write_url(row, 5, url, string=f"{stage}: {job}", cell_format=wrap_fmt)
            row += 1

    workbook.close()
    logger.info(f"Report written to {OUTPUT_FILE}")


if __name__ == "__main__":
    main()
