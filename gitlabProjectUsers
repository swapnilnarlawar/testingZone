import requests
import pandas as pd
import urllib3
import logging

# ====== CONFIGURATION ======
GITLAB_URL = "https://gitlab.example.com"
PRIVATE_TOKEN = "<YOUR_ACCESS_TOKEN>"
GROUP_ID = "<YOUR_GROUP_ID>"
SSL_VERIFY = False   # disable SSL verification if cert is self-signed

HEADERS = {"PRIVATE-TOKEN": PRIVATE_TOKEN}

# Disable SSL warnings
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# Setup logging
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[logging.StreamHandler()]
)

# ====== ACCESS LEVEL MAPPING ======
ACCESS_LEVELS = {
    10: "Guest",
    20: "Reporter",
    30: "Developer",
    40: "Maintainer",
    50: "Owner"
}

def access_level_name(level):
    return ACCESS_LEVELS.get(level, f"Unknown ({level})")

# ====== HELPER FUNCTIONS ======
def fetch_json(url):
    results = []
    page = 1
    while True:
        resp = requests.get(f"{url}?page={page}&per_page=100", headers=HEADERS, verify=SSL_VERIFY)
        if resp.status_code != 200:
            logging.error(f"Failed to fetch {url}, status {resp.status_code}, response: {resp.text}")
            break
        data = resp.json()
        if not data:
            break
        results.extend(data)
        page += 1
    return results

def get_group_details(group_id):
    resp = requests.get(f"{GITLAB_URL}/api/v4/groups/{group_id}", headers=HEADERS, verify=SSL_VERIFY)
    if resp.status_code != 200:
        logging.error(f"Failed to fetch group details for {group_id}, status {resp.status_code}, response: {resp.text}")
        return {"name": f"Group:{group_id}", "id": group_id}
    return resp.json()

def get_group_members(group_id):
    logging.info(f"Fetching members of group {group_id}")
    direct = fetch_json(f"{GITLAB_URL}/api/v4/groups/{group_id}/members")
    all_members = fetch_json(f"{GITLAB_URL}/api/v4/groups/{group_id}/members/all")

    direct_ids = {m["id"] for m in direct}
    results = []

    for m in direct:
        m["membership_type"] = "Direct"
        results.append(m)

    for m in all_members:
        if m["id"] not in direct_ids:
            m["membership_type"] = "Inherited"
            results.append(m)

    return results

def get_project_members(project_id):
    logging.info(f"Fetching members of project {project_id}")
    direct = fetch_json(f"{GITLAB_URL}/api/v4/projects/{project_id}/members")
    all_members = fetch_json(f"{GITLAB_URL}/api/v4/projects/{project_id}/members/all")

    direct_ids = {m["id"] for m in direct}
    results = []

    for m in direct:
        m["membership_type"] = "Direct"
        results.append(m)

    for m in all_members:
        if m["id"] not in direct_ids:
            m["membership_type"] = "Inherited"
            results.append(m)

    return results

def get_group_projects(group_id):
    logging.info(f"Fetching projects under group {group_id}")
    return fetch_json(f"{GITLAB_URL}/api/v4/groups/{group_id}/projects")

def get_subgroups(group_id):
    logging.info(f"Fetching subgroups of group {group_id}")
    return fetch_json(f"{GITLAB_URL}/api/v4/groups/{group_id}/subgroups")

# ====== RECURSIVE FETCH ======
def fetch_all_members(group_id, path="Group", source_id=None):
    records = []

    # 1️⃣ Group members
    for m in get_group_members(group_id):
        records.append({
            "Username": m["username"],
            "Name": m["name"],
            "Access Level": access_level_name(m["access_level"]),
            "Potential Build Eng": "Yes" if m["access_level"] >= 30 else "No",
            "Source": path,
            "Source ID": source_id,
            "Membership Type": m.get("membership_type", "Unknown")
        })

    # 2️⃣ Projects
    for project in get_group_projects(group_id):
        proj_path = f"Project: {project['name']}"
        for m in get_project_members(project["id"]):
            records.append({
                "Username": m["username"],
                "Name": m["name"],
                "Access Level": access_level_name(m["access_level"]),
                "Potential Build Eng": "Yes" if m["access_level"] >= 30 else "No",
                "Source": proj_path,
                "Source ID": project["id"],
                "Membership Type": m.get("membership_type", "Unknown")
            })

    # 3️⃣ Subgroups
    for subgroup in get_subgroups(group_id):
        sub_path = f"Subgroup: {subgroup['name']}"
        records.extend(fetch_all_members(subgroup['id'], path=sub_path, source_id=subgroup['id']))

    return records

# ====== MAIN ======
if __name__ == "__main__":
    logging.info("Starting GitLab user fetch...")

    root_group = get_group_details(GROUP_ID)
    root_group_name = f"Group: {root_group['name']}"
    all_records = fetch_all_members(GROUP_ID, path=root_group_name, source_id=root_group["id"])

    logging.info(f"Fetched {len(all_records)} user-source records (raw, including duplicates).")

    # Convert to DataFrame
    df = pd.DataFrame(all_records)
    df = df.sort_values(by=["Name", "Source", "Membership Type"])

    # Show preview
    logging.info("Preview of results:")
    print(df.head(20).to_string(index=False))

    # Save CSV
    output_file = "gitlab_group_user_mapping.csv"
    df.to_csv(output_file, index=False)
    logging.info(f"Results written to {output_file}")
