#!/usr/bin/env bash
# --------------------------------------------------------------------
# List Azure AD groups matching a prefix and their members per environment,
# with optional filtering, parallelized lookups, skip-word filter,
# dynamic env code mapping from ENV_MAP, table/CSV export, and logs.
# --------------------------------------------------------------------

set -euo pipefail

# -------------------------
# Argument parsing
# -------------------------
PREFIX=${1:?Error: prefix required}

FILTER_ENV=${2:-""}
PARALLEL=${3:-5}
SKIP_WORDS=${4:-""}
ENV_MAP=${5:-"xyf:dev,xyg:test,xyh:preprod,xyj:prod"}

# -------------------------
# Output directories and files
# -------------------------
OUTPUT_DIR="./aad_group_reports"
TMP_DIR="${OUTPUT_DIR}/tmp_logs"
mkdir -p "$OUTPUT_DIR" "$TMP_DIR"

DATE_STR=$(date +%Y%m%d_%H%M%S)
FINAL_LOG="${OUTPUT_DIR}/${PREFIX}_aad_groups_full_${DATE_STR}.log"
TABLE_FILE="${OUTPUT_DIR}/${PREFIX}_aad_groups_table_${DATE_STR}.txt"
CSV_FILE="${OUTPUT_DIR}/${PREFIX}_aad_groups_${DATE_STR}.csv"
ERROR_LOG="${OUTPUT_DIR}/${PREFIX}_errors_${DATE_STR}.log"

# -------------------------
# Pre-flight checks
# -------------------------
for cmd in az jq xargs awk sed curl; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "❌ Required command '$cmd' not found. Please install."
        exit 1
    fi
done

# Check Azure CLI login status
if ! az account show >/dev/null 2>&1; then
    echo "❌ Not logged into Azure CLI. Please run: az login"
    exit 1
fi

# Refresh Azure CLI token to ensure it meets current policies
echo "🔄 Refreshing Azure CLI token..."
if ! az account get-access-token --resource https://graph.microsoft.com >/dev/null 2>&1; then
    echo "❌ Could not obtain access token. Please run: az login"
    exit 1
fi

# -------------------------
# Header output
# -------------------------
echo "🔍 Searching Azure AD groups with prefix: $PREFIX"
[[ -n "$FILTER_ENV" ]] && echo "🌍 Filtering for environment: $FILTER_ENV (case-insensitive)"
[[ -n "$SKIP_WORDS" ]] && echo "🚫 Skipping groups containing words: $SKIP_WORDS"
echo "⚡ Parallelism: $PARALLEL"
echo "🗺  Env mapping: $ENV_MAP"
echo

# -------------------------
# Fetch groups from Azure AD
# -------------------------
echo "🔄 Getting access token..."
ACCESS_TOKEN=$(az account get-access-token --resource https://graph.microsoft.com --query accessToken -o tsv 2>/dev/null)

if [[ -z "$ACCESS_TOKEN" ]]; then
    echo "❌ ERROR: Could not obtain access token. Please run: az login"
    exit 1
fi

echo "📋 Fetching groups from Azure AD..."
groups_response=$(curl -s -X GET \
    "https://graph.microsoft.com/v1.0/groups?\$filter=startswith(displayName,'${PREFIX}')&\$select=id,displayName" \
    -H "Authorization: Bearer $ACCESS_TOKEN" \
    -H "Content-Type: application/json")

# Check for API errors
if echo "$groups_response" | jq -e '.error' >/dev/null 2>&1; then
    echo "❌ ERROR: Graph API returned an error:"
    echo "$groups_response" | jq '.error'
    exit 1
fi

TMP_GROUPS="${TMP_DIR}/aad_groups_$$.txt"
echo "$groups_response" | jq -r '.value[]? | [.id, .displayName] | @tsv' > "$TMP_GROUPS"

# Check if any groups were found
if [[ ! -s "$TMP_GROUPS" ]]; then
    echo "⚠️  No groups found with prefix: $PREFIX"
    exit 0
fi

# -------------------------
# Function: translate env code
# -------------------------
translate_env() {
    local code="$1"
    IFS=',' read -ra pairs <<< "$ENV_MAP"
    for pair in "${pairs[@]}"; do
        IFS=':' read -r k v <<< "$pair"
        if [[ "$k" == "$code" ]]; then
            echo "$v"
            return
        fi
    done
    echo "unknown"
}
export -f translate_env
export ENV_MAP

# -------------------------
# Derive env codes dynamically from ENV_MAP
# -------------------------
ENV_CODES_REGEX=$(echo "$ENV_MAP" | awk -F, '{
    for(i=1;i<=NF;i++){
        split($i,k,":");
        codes[i]=k[1]
    }
    for(i=1;i<=NF;i++){
        printf "%s", codes[i]
        if(i<NF) printf "|"
    }
}')
export ENV_CODES_REGEX

# -------------------------
# Apply skip-word filter if present
# -------------------------
if [[ -n "$SKIP_WORDS" ]]; then
    TMP_GROUPS_FILTERED_SKIP="${TMP_DIR}/aad_groups_skip_$$.txt"
    awk -v skip="$SKIP_WORDS" '
    BEGIN { n = split(skip, words, ",") }
    {
        skip_group=0
        for(i=1;i<=n;i++){
            w=words[i]
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", w)
            if(tolower($2) ~ tolower(w)) skip_group=1
        }
        if(skip_group==0) print $0
    }' "$TMP_GROUPS" > "$TMP_GROUPS_FILTERED_SKIP"
    TMP_GROUPS="$TMP_GROUPS_FILTERED_SKIP"
fi

# -------------------------
# Apply environment filter if FILTER_ENV is specified
# -------------------------
if [[ -n "$FILTER_ENV" ]]; then
    TMP_GROUPS_FILTERED_ENV="${TMP_DIR}/aad_groups_env_$$.txt"
    awk -v env="$FILTER_ENV" -v env_map="$ENV_MAP" -v regex_codes="$ENV_CODES_REGEX" '
    function translate(code, env_map) {
        n = split(env_map, arr, ",")
        for(i=1;i<=n;i++){
            split(arr[i], kv, ":")
            if(kv[1]==code) return kv[2]
        }
        return "unknown"
    }
    {
        envCode=""
        regex="-((" regex_codes ")){1}_"
        if($2 ~ regex) { match($2, regex, a); envCode=a[1] }
        if(tolower(translate(envCode, env_map))==tolower(env)) print $0
    }' "$TMP_GROUPS" > "$TMP_GROUPS_FILTERED_ENV"
    TMP_GROUPS="$TMP_GROUPS_FILTERED_ENV"
    
    # Check if filtering resulted in no groups
    if [[ ! -s "$TMP_GROUPS" ]]; then
        echo "⚠️  No groups found after filtering for environment: $FILTER_ENV"
        exit 0
    fi
fi

# -------------------------
# Count total groups
# -------------------------
TOTAL_GROUPS=$(wc -l < "$TMP_GROUPS")
echo "📊 Total groups to process: $TOTAL_GROUPS"
echo

# -------------------------
# Initialize output files with proper headers
# -------------------------
printf "%-60s %-12s %-40s %-50s %-20s\n" "GroupName" "Environment" "MemberDisplayName" "UserPrincipalName/AppId" "ObjectType" > "$TABLE_FILE"
echo "GroupName,Environment,MemberDisplayName,UserPrincipalName,ObjectId,ObjectType" > "$CSV_FILE"

# Create separate temp files for each output to avoid write conflicts
TABLE_TEMP_DIR="${TMP_DIR}/table_parts"
CSV_TEMP_DIR="${TMP_DIR}/csv_parts"
mkdir -p "$TABLE_TEMP_DIR" "$CSV_TEMP_DIR"

PROGRESS_COUNTER="${TMP_DIR}/progress_counter_$$.txt"
echo 0 > "$PROGRESS_COUNTER"

export TABLE_FILE CSV_FILE ERROR_LOG FILTER_ENV PROGRESS_COUNTER TOTAL_GROUPS SKIP_WORDS TMP_DIR PREFIX DATE_STR TABLE_TEMP_DIR CSV_TEMP_DIR

# -------------------------
# Process groups in parallel
# -------------------------
process_group() {
    local groupId="$1"
    local groupName="$2"
    
    # Skip words check (optional)
    if [[ -n "$SKIP_WORDS" ]]; then
        IFS="," read -ra words <<< "$SKIP_WORDS"
        for word in "${words[@]}"; do
            word=$(echo "$word" | xargs)  # Trim whitespace
            if [[ "${groupName,,}" == *"${word,,}"* ]]; then
                echo "⏭️  Skipping group $groupName due to skip word: $word"
                return 0
            fi
        done
    fi
    
    # Env translation
    envCode=$(echo "$groupName" | sed -nE "s/.*-(${ENV_CODES_REGEX})_.*/\1/p" | head -n1)
    [[ -z "$envCode" ]] && envCode="unknown"
    envName=$(translate_env "$envCode")
    
    # Env filter (optional)
    if [[ -n "$FILTER_ENV" && "${FILTER_ENV,,}" != "${envName,,}" ]]; then
        return 0
    fi
    
    # Update progress - use unique temp file per process
    PROGRESS_TEMP="${PROGRESS_COUNTER}_${groupId}"
    echo "1" > "$PROGRESS_TEMP"
    
    printf "Processing: %s (%s)\n" "$groupName" "$envName"
    
    # Fetch ALL members including users, service principals, and managed identities
    # Get a fresh access token for this subprocess
    ACCESS_TOKEN=$(az account get-access-token --resource https://graph.microsoft.com --query accessToken -o tsv 2>/dev/null)
    
    if [[ -z "$ACCESS_TOKEN" ]]; then
        echo "❌ ERROR: Could not obtain access token for group $groupName" | tee -a "$ERROR_LOG" >&2
        return 1
    fi
    
    # Use beta endpoint with explicit token to get all member types including UAMIs
    members_response=$(curl -s -X GET \
        "https://graph.microsoft.com/beta/groups/$groupId/members" \
        -H "Authorization: Bearer $ACCESS_TOKEN" \
        -H "Content-Type: application/json" 2>/dev/null || echo '{"value":[]}')
    
    # Check for API errors
    if echo "$members_response" | jq -e '.error' >/dev/null 2>&1; then
        echo "❌ ERROR processing group $groupName: $(echo "$members_response" | jq -r '.error.message')" | tee -a "$ERROR_LOG" >&2
        return 1
    fi
    
    # Extract only the fields we need from the response
    members=$(echo "$members_response" | jq '[.value[]? | {
        id: .id, 
        displayName: .displayName, 
        userPrincipalName: .userPrincipalName, 
        appId: .appId, 
        servicePrincipalType: .servicePrincipalType,
        odatatype: .["@odata.type"]
    }]' 2>/dev/null || echo '[]')
    
    memberCount=$(echo "$members" | jq length)
    
    # Create unique temp files for this group's output
    TABLE_TEMP_FILE="${TABLE_TEMP_DIR}/${groupId}.txt"
    CSV_TEMP_FILE="${CSV_TEMP_DIR}/${groupId}.csv"
    
    LOG_FILE="${TMP_DIR}/${PREFIX}_log_${groupName//\//_}_${DATE_STR}.txt"
    
    {
        printf "%s\n" "============================================================"
        printf "📘 Group: %s\n" "$groupName"
        printf "🆔 Group ID: %s\n" "$groupId"
        printf "🌍 Environment: %s\n" "$envName"
        printf "👥 Members: %d\n" "$memberCount"
        printf "%s\n" "------------------------------------------------------------"
        
        if [[ "$memberCount" -gt 0 ]]; then
            echo "$members" | jq -r '.[] | [.displayName // "N/A", .userPrincipalName // .appId // "N/A", .id // "N/A", .odatatype // "N/A", .servicePrincipalType // "N/A"] | @tsv' | while IFS=$'\t' read -r displayName upn id objectType spnType; do
                # Clean up object type to be more readable
                objectType=$(echo "$objectType" | sed 's|#microsoft.graph.||')
                
                # Determine the actual type with more precision
                if [[ "$objectType" == "servicePrincipal" ]]; then
                    if [[ "$spnType" == "ManagedIdentity" ]]; then
                        objectType="UAMI"
                    elif [[ "$spnType" == "Application" ]]; then
                        objectType="SPN"
                    else
                        objectType="ServicePrincipal"
                    fi
                fi
                
                # Write to temp files (each process has its own file - no conflicts)
                printf "%-60s %-12s %-40s %-50s %-20s\n" "$groupName" "$envName" "$displayName" "$upn" "$objectType" >> "$TABLE_TEMP_FILE"
                printf '"%s","%s","%s","%s","%s","%s"\n' "$groupName" "$envName" "$displayName" "$upn" "$id" "$objectType" >> "$CSV_TEMP_FILE"
                
                printf "  ├─ %s\n" "$displayName"
                printf "     │ Type: %s\n" "$objectType"
                printf "     │ UPN/AppId: %s\n" "$upn"
                printf "     └ ID: %s\n" "$id"
            done
        else
            # Write empty group to temp files
            printf "%-60s %-12s %-40s %-50s %-20s\n" "$groupName" "$envName" "(No members)" "-" "-" >> "$TABLE_TEMP_FILE"
            printf '"%s","%s","%s","%s","%s","%s"\n' "$groupName" "$envName" "No members" "-" "-" "-" >> "$CSV_TEMP_FILE"
            
            printf "  └─ (No members)\n"
        fi
        printf "\n"
    } >> "$LOG_FILE" 2>&1
}

export -f process_group

# Process groups with proper argument handling
echo "🚀 Starting parallel processing..."
echo

cat "$TMP_GROUPS" | while IFS=

# -------------------------
# Merge all temp files into final outputs
# -------------------------
echo
echo "📝 Merging results..."

# Merge table parts
if ls "$TABLE_TEMP_DIR"/*.txt >/dev/null 2>&1; then
    cat "$TABLE_TEMP_DIR"/*.txt >> "$TABLE_FILE"
fi

# Merge CSV parts
if ls "$CSV_TEMP_DIR"/*.csv >/dev/null 2>&1; then
    cat "$CSV_TEMP_DIR"/*.csv >> "$CSV_FILE"
fi

# -------------------------
# Clean up temp files
# -------------------------
rm -rf "$TABLE_TEMP_DIR" "$CSV_TEMP_DIR"
rm -f "$TMP_DIR"/aad_groups_* "${PROGRESS_COUNTER}"_*

# -------------------------
# Consolidate logs
# -------------------------
echo "📝 Consolidating logs..."
if ls "${TMP_DIR}"/*.txt >/dev/null 2>&1; then
    cat "${TMP_DIR}"/*.txt > "$FINAL_LOG" 2>&1
    rm -f "${TMP_DIR}"/*.txt
else
    echo "No logs to consolidate" > "$FINAL_LOG"
fi

# -------------------------
# Summary statistics
# -------------------------
if [[ -f "$CSV_FILE" ]] && [[ $(wc -l < "$CSV_FILE") -gt 1 ]]; then
    TOTAL_MEMBERS=$(tail -n +2 "$CSV_FILE" | grep -v "No members" | wc -l)
    GROUPS_WITH_MEMBERS=$(tail -n +2 "$CSV_FILE" | cut -d',' -f1 | sort -u | wc -l)
    TOTAL_USERS=$(tail -n +2 "$CSV_FILE" | grep -i ',user"' | wc -l)
    TOTAL_SPNS=$(tail -n +2 "$CSV_FILE" | grep -i ',spn"' | wc -l)
    TOTAL_UAMIS=$(tail -n +2 "$CSV_FILE" | grep -i ',uami"' | wc -l)
else
    TOTAL_MEMBERS=0
    GROUPS_WITH_MEMBERS=0
    TOTAL_USERS=0
    TOTAL_SPNS=0
    TOTAL_UAMIS=0
fi

# -------------------------
# Done
# -------------------------
echo
echo "✅ Report complete!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📊 Summary Statistics:"
echo "   • Groups processed: $TOTAL_GROUPS"
echo "   • Groups with members: $GROUPS_WITH_MEMBERS"
echo "   • Total members: $TOTAL_MEMBERS"
echo "   • Users: $TOTAL_USERS"
echo "   • Service Principals: $TOTAL_SPNS"
echo "   • Managed Identities (UAMIs): $TOTAL_UAMIS"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📄 Table format: $TABLE_FILE"
echo "📊 CSV format: $CSV_FILE"
echo "📝 Full log: $FINAL_LOG"
[[ -f "$ERROR_LOG" ]] && echo "⚠️  Error log: $ERROR_LOG"
echo\t' read -r groupId groupName; do
    echo "$groupId" "$groupName"
done | xargs -L1 -P"$PARALLEL" bash -c 'process_group "$1" "$2"' --

echo
echo "✅ All groups processed!"

# -------------------------
# Merge all temp files into final outputs
# -------------------------
echo
echo "📝 Merging results..."

# Merge table parts
if ls "$TABLE_TEMP_DIR"/*.txt >/dev/null 2>&1; then
    cat "$TABLE_TEMP_DIR"/*.txt >> "$TABLE_FILE"
fi

# Merge CSV parts
if ls "$CSV_TEMP_DIR"/*.csv >/dev/null 2>&1; then
    cat "$CSV_TEMP_DIR"/*.csv >> "$CSV_FILE"
fi

# -------------------------
# Clean up temp files
# -------------------------
rm -rf "$TABLE_TEMP_DIR" "$CSV_TEMP_DIR"
rm -f "$TMP_DIR"/aad_groups_* "${PROGRESS_COUNTER}"_*

# -------------------------
# Consolidate logs
# -------------------------
echo "📝 Consolidating logs..."
if ls "${TMP_DIR}"/*.txt >/dev/null 2>&1; then
    cat "${TMP_DIR}"/*.txt > "$FINAL_LOG" 2>&1
    rm -f "${TMP_DIR}"/*.txt
else
    echo "No logs to consolidate" > "$FINAL_LOG"
fi

# -------------------------
# Summary statistics
# -------------------------
if [[ -f "$CSV_FILE" ]] && [[ $(wc -l < "$CSV_FILE") -gt 1 ]]; then
    TOTAL_MEMBERS=$(tail -n +2 "$CSV_FILE" | grep -v "No members" | wc -l)
    GROUPS_WITH_MEMBERS=$(tail -n +2 "$CSV_FILE" | cut -d',' -f1 | sort -u | wc -l)
    TOTAL_USERS=$(tail -n +2 "$CSV_FILE" | grep -i ',user"' | wc -l)
    TOTAL_SPNS=$(tail -n +2 "$CSV_FILE" | grep -i ',spn"' | wc -l)
    TOTAL_UAMIS=$(tail -n +2 "$CSV_FILE" | grep -i ',uami"' | wc -l)
else
    TOTAL_MEMBERS=0
    GROUPS_WITH_MEMBERS=0
    TOTAL_USERS=0
    TOTAL_SPNS=0
    TOTAL_UAMIS=0
fi

# -------------------------
# Done
# -------------------------
echo
echo "✅ Report complete!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📊 Summary Statistics:"
echo "   • Groups processed: $TOTAL_GROUPS"
echo "   • Groups with members: $GROUPS_WITH_MEMBERS"
echo "   • Total members: $TOTAL_MEMBERS"
echo "   • Users: $TOTAL_USERS"
echo "   • Service Principals: $TOTAL_SPNS"
echo "   • Managed Identities (UAMIs): $TOTAL_UAMIS"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📄 Table format: $TABLE_FILE"
echo "📊 CSV format: $CSV_FILE"
echo "📝 Full log: $FINAL_LOG"
[[ -f "$ERROR_LOG" ]] && echo "⚠️  Error log: $ERROR_LOG"
echo
