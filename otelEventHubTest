object EventHubEndToEnd {

  // JSON serializer
  implicit val formats = Serialization.formats(NoTypeHints)

  // Metric model
  case class Metric(name: String, value: Double, timestamp: Long)

  // -------------------------------
  // 🔍 Step 1: Check dependencies
  // -------------------------------
  val dependencies = Map(
    "azure-identity" -> "com.azure.identity.ClientSecretCredentialBuilder",
    "azure-core" -> "com.azure.core.credential.TokenCredential",
    "azure-messaging-eventhubs" -> "com.azure.messaging.eventhubs.EventHubClientBuilder",
    "reactor-core" -> "reactor.core.publisher.Flux",
    "reactor-netty" -> "reactor.netty.http.client.HttpClient",
    "slf4j-api" -> "org.slf4j.Logger",
    "jackson-core" -> "com.fasterxml.jackson.core.JsonFactory",
    "jackson-databind" -> "com.fasterxml.jackson.databind.ObjectMapper",
    "jackson-annotations" -> "com.fasterxml.jackson.annotation.JsonProperty",
    "netty-handler" -> "io.netty.handler.codec.http.HttpClientCodec",
    "netty-buffer" -> "io.netty.buffer.ByteBuf",
    "netty-common" -> "io.netty.util.concurrent.Future",
    "netty-transport" -> "io.netty.channel.Channel",
    "netty-resolver" -> "io.netty.resolver.DefaultAddressResolverGroup",
    "msal4j" -> "com.microsoft.aad.msal4j.ConfidentialClientApplication",
    "commons-codec" -> "org.apache.commons.codec.binary.Base64",
    "commons-logging" -> "org.apache.commons.logging.Log",
    "okhttp" -> "okhttp3.OkHttpClient"
  )

  def checkClassExists(className: String): Boolean = {
    try {
      Class.forName(className)
      true
    } catch {
      case _: ClassNotFoundException => false
    }
  }

  // -------------------------------
  // 🔑 Step 2: Verify credentials
  // -------------------------------
  def verifyCredentials(tenantId: String, clientId: String, clientSecret: String): Boolean = {
    val authority = s"https://login.microsoftonline.com/$tenantId/"
    val app = ConfidentialClientApplication.builder(
      clientId,
      ClientCredentialFactory.createFromSecret(clientSecret)
    ).authority(authority).build()

    val scopes = Collections.singleton("https://eventhubs.azure.net/.default")

    try {
      val result = app.acquireToken(
        ClientCredentialParameters.builder(scopes).build()
      ).get()
      println(s"✅ Credentials valid. Token begins with: ${result.accessToken.substring(0, 20)}...")
      true
    } catch {
      case e: Exception =>
        println(s"❌ Invalid credentials: ${e.getMessage}")
        false
    }
  }

  // -------------------------------
  // 📤 Step 3: Send metric
  // -------------------------------
  def sendMetric(namespace: String, eventHub: String, credential: com.azure.core.credential.TokenCredential): Unit = {
    val producer = new EventHubClientBuilder()
      .credential(namespace, eventHub, credential)
      .buildAsyncProducerClient()

    val metric = Metric("cpu_usage_percent", 42.5, System.currentTimeMillis())
    val metricJson = write(metric)
    val event = new EventData(metricJson)

    producer.send(Seq(event).asJava).block()
    println(s"✅ Metric sent: $metricJson")
    producer.close()
  }

  // -------------------------------
  // 📥 Step 4: Receive metric
  // -------------------------------
  def receiveMetrics(namespace: String, eventHub: String, credential: com.azure.core.credential.TokenCredential): Unit = {
    val consumer = new EventHubClientBuilder()
      .credential(namespace, eventHub, credential)
      .consumerGroup(EventHubClientBuilder.DEFAULT_CONSUMER_GROUP_NAME)
      .buildAsyncConsumerClient()

    val partitions = consumer.getPartitionIds().block()
    partitions.asScala.foreach { pid =>
      println(s"Listening on partition: $pid")
      consumer.receiveFromPartition(pid, EventPosition.latest())
        .take(5)
        .subscribe(event => {
          val data = event.getData
          if (data != null) {
            println(s"📥 Received from partition $pid: ${data.getBodyAsString()}")
          }
        })
    }

    Thread.sleep(5000)
    consumer.close()
  }

  // -------------------------------
  // 🚀 Main entry point
  // -------------------------------
  def main(args: Array[String]): Unit = {

    // Load env vars
    val tenantId     = sys.env("AZ_TENANT_ID")
    val clientId     = sys.env("AZ_CLIENT_ID")
    val clientSecret = sys.env("AZ_CLIENT_SECRET")
    val namespace    = sys.env("AZ_EVENTHUB_NAMESPACE") // e.g. "xxx.servicebus.windows.net"
    val eventHub     = sys.env("AZ_EVENTHUB_NAME")

    // Step 1: Check dependencies
    println("🔍 Dependency check:")
    dependencies.foreach { case (lib, cls) =>
      println(f"$lib%-25s : ${checkClassExists(cls)}")
    }

    // Step 2: Verify credentials
    if (!verifyCredentials(tenantId, clientId, clientSecret)) {
      sys.error("❌ Exiting due to invalid credentials")
    }

    // Build Azure credential
    val credential = new ClientSecretCredentialBuilder()
      .tenantId(tenantId)
      .clientId(clientId)
      .clientSecret(clientSecret)
      .build()

    // Step 3: Send a sample metric
    sendMetric(namespace, eventHub, credential)

    // Step 4: Receive metric
    receiveMetrics(namespace, eventHub, credential)
  }
}

