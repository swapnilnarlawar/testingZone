import com.azure.identity.ClientSecretCredentialBuilder
import com.azure.messaging.eventhubs._
import com.azure.messaging.eventhubs.models.EventPosition
import org.json4s.native.Serialization
import org.json4s.native.Serialization.write
import org.json4s.NoTypeHints
import scala.jdk.CollectionConverters._
import reactor.core.publisher.Flux
import java.util.Collections

object EventHubSendAndReceive {

  implicit val formats = Serialization.formats(NoTypeHints)

  case class Metric(name: String, value: Double, timestamp: Long)

  def main(args: Array[String]): Unit = {

    // -------------------------------
    // 1️⃣ Load environment variables
    // -------------------------------
    val tenantId     = sys.env("AZ_TENANT_ID")
    val clientId     = sys.env("AZ_CLIENT_ID")
    val clientSecret = sys.env("AZ_CLIENT_SECRET")
    val namespace    = sys.env("AZ_EVENTHUB_NAMESPACE") // e.g., "myeventhub.servicebus.windows.net"
    val eventHub     = sys.env("AZ_EVENTHUB_NAME")

    val credential = new ClientSecretCredentialBuilder()
      .tenantId(tenantId)
      .clientId(clientId)
      .clientSecret(clientSecret)
      .build()

    // -------------------------------
    // 2️⃣ Send sample metric
    // -------------------------------
    val producer = new EventHubClientBuilder()
      .credential(namespace, eventHub, credential)
      .buildAsyncProducerClient()

    val metric = Metric("cpu_usage_percent", 42.5, System.currentTimeMillis())
    val metricJson = write(metric)

    val singleEvent = new EventData(metricJson)
    producer.send(List(singleEvent).asJava).block()
    println(s"✅ Metric sent: $metricJson")
    producer.close()

    // -------------------------------
    // 3️⃣ Receive metric from Event Hub
    // -------------------------------
    val consumer = new EventHubClientBuilder()
      .credential(namespace, eventHub, credential)
      .consumerGroup(EventHubClientBuilder.DEFAULT_CONSUMER_GROUP_NAME)
      .buildAsyncConsumerClient()

    val partitions = consumer.getPartitionIds().block()
    partitions.asScala.foreach { pid =>
      println(s"Listening on partition: $pid")
      consumer.receiveFromPartition(pid, EventPosition.latest())
        .take(5) // read up to 5 messages per partition
        .subscribe(event => {
          println(s"📥 Received event from partition $pid: ${event.getBodyAsString()}")
        })
    }

    // Wait a few seconds for messages to arrive
    Thread.sleep(5000)
    consumer.close()
    println("Consumer closed.")
  }
}






