import com.azure.identity.ClientSecretCredentialBuilder
import com.azure.messaging.eventhubs._
import com.azure.messaging.eventhubs.models.{EventPosition, PartitionEvent}
import com.microsoft.aad.msal4j._
import org.json4s.native.Serialization
import org.json4s.native.Serialization.write
import org.json4s.NoTypeHints
import java.util.Collections
import scala.jdk.CollectionConverters._
import reactor.core.publisher.{Flux, Mono}

object EventHubTestReactive {

  implicit val formats = Serialization.formats(NoTypeHints)
  case class Metric(name: String, value: Double, timestamp: Long)

  def verifyCredentials(tenantId: String, clientId: String, clientSecret: String): Boolean = {
    val authority = s"https://login.microsoftonline.com/$tenantId/"
    val app = ConfidentialClientApplication.builder(
      clientId,
      ClientCredentialFactory.createFromSecret(clientSecret)
    ).authority(authority).build()
    val scopes = Collections.singleton("https://eventhubs.azure.net/.default")
    try {
      val result = app.acquireToken(ClientCredentialParameters.builder(scopes).build()).get()
      println(s"✅ Credentials valid. Token begins with: ${result.accessToken.substring(0, 20)}...")
      true
    } catch {
      case e: Exception =>
        println(s"❌ Invalid credentials: ${e.getMessage}")
        false
    }
  }

  def sendMetricAsync(namespace: String, eventHub: String, credential: com.azure.core.credential.TokenCredential): Mono[Void] = {
    val producer = new EventHubClientBuilder()
      .credential(namespace, eventHub, credential)
      .buildAsyncProducerClient()
    val metric = Metric("cpu_usage_percent", 42.5, System.currentTimeMillis())
    val event = new EventData(write(metric))

    producer.send(List(event).asJava)
      .doOnSuccess(_ => println(s"✅ Metric sent: ${write(metric)}"))
      .doFinally(_ => producer.close())
  }

  def receiveMetricsAsync(namespace: String, eventHub: String, credential: com.azure.core.credential.TokenCredential): Flux[PartitionEvent] = {
    val consumer = new EventHubClientBuilder()
      .credential(namespace, eventHub, credential)
      .consumerGroup(EventHubClientBuilder.DEFAULT_CONSUMER_GROUP_NAME)
      .buildAsyncConsumerClient()

    val partitionIds = consumer.getPartitionIds().collectList().block().asScala
    val partitionsFlux = Flux.fromIterable(partitionIds)
      .flatMap(pid => {
        println(s"Listening on partition: $pid")
        consumer.receiveFromPartition(pid, EventPosition.latest())
          .take(5)
          .doFinally(_ => println(s"✅ Finished reading from partition $pid"))
      })

    partitionsFlux.doFinally(_ => consumer.close())
  }

  def main(args: Array[String]): Unit = {

    val tenantId = sys.env("AZ_TENANT_ID")
    val clientId = sys.env("AZ_CLIENT_ID")
    val clientSecret = sys.env("AZ_CLIENT_SECRET")
    val namespace = sys.env("AZ_EVENTHUB_NAMESPACE")
    val eventHub = sys.env("AZ_EVENTHUB_NAME")

    if (!verifyCredentials(tenantId, clientId, clientSecret)) sys.error("❌ Invalid credentials")

    val credential = new ClientSecretCredentialBuilder()
      .tenantId(tenantId)
      .clientId(clientId)
      .clientSecret(clientSecret)
      .build()

    // Fully reactive chain: send metric, then receive metrics
    val reactiveFlow = sendMetricAsync(namespace, eventHub, credential)
      .thenMany(receiveMetricsAsync(namespace, eventHub, credential))
      .doOnNext(event => println(s"📥 Received: ${event.getData.getBodyAsString}"))
      .doOnError(err => println(s"❌ Error: $err"))
      .doOnComplete(() => println("✅ Reactive processing complete"))

    // Block only once to keep JVM alive until all async operations finish
    reactiveFlow.blockLast()
  }
}

